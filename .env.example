# ACB credentials (do not commit real values)
CLIENT_ID=acb-client-id
ACB_CLIENT_SECRET=acb-client-secret
# Backward-compatible typo used by the original environment:
SCRECET_ID=
ACB_BASE_URL=https://sandbox.acb.com.vn
ACB_TOKEN_URL=https://sandbox.acb.com.vn/acb/open/iam/id/v1/auth/realms/soba/protocol/openid-connect/token
ACB_GRANT_TYPE=client_credentials
ACB_SCOPE=soba-api
ACB_REQUEST_TIMEOUT_MS=15000
# Values issued in the ACB sandbox test-data workbook.
ACB_X_CHANNEL=SOBA
ACB_PROVIDER_ID=
ACB_SERVICE=
ACB_TEST_ACCOUNT=
# Optional compatibility header; current ACB contracts use Bearer + X-Client-ID.
ACB_API_SECRET=
ACB_HEADER_CHANNEL_NAME=x-channel
ACB_HEADER_REQUEST_ID_NAME=x-request-id
ACB_HEADER_CLIENT_ID_NAME=x-client-id
ACB_HEADER_PROVIDER_ID_NAME=x-provider-id
ACB_HEADER_SERVICE_NAME=x-service
ACB_HEADER_SECRET_NAME=
ACB_API_PREFIX=/acb/open/account-information/v1
ACB_PATH_ACCOUNTS=/acb/open/customers/account/v1/accounts
ACB_PATH_BALANCES=/acb/open/customers/account/v1/balances
ACB_PATH_TRANSACTION_HISTORY=/acb/open/accounts/transactions/v1/transaction-history
ACB_PATH_STATEMENTS=/acb/open/customers/account/v1/statements
ACB_PATH_TRANSACTION_DETAIL=/acb/open/customers/account/v1/transaction/detail
ACB_PATH_STATEMENT_RETRIEVE=/acb/open/oe/current-account/v1/statement/retrieve
ACB_PATH_STATEMENT_INQUIRY=/acb/open/oe/current-account/v1/account/statement/inquiry
ACB_PATH_ESTATEMENT_REGISTRATION=/acb/open/oe/current-account/v1/e-statement/registration
ACB_PATH_SANDBOX_CREDIT=/acb/open/payment/payment-execution/v1/credit
ACB_PATH_SANDBOX_DEBIT=/acb/open/payment/payment-execution/v1/debit

# Callback security and durable inbox
ACB_CALLBACK_TOKEN=generate-at-least-24-random-bytes
ACB_WEBHOOK_AUTH_REQUIRED=true
ACB_WEBHOOK_TOKEN=generate-a-separate-webhook-token
ACB_CALLBACK_MAX_BODY_BYTES=1048576
INBOX_POLL_INTERVAL_MS=1000
INBOX_BATCH_SIZE=20
INBOX_MAX_ATTEMPTS=8

# PostgreSQL (SSL is intentionally disabled for the current rollout)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=payment_duni
POSTGRES_DB=payment_duni
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=false

PORT=3000
NODE_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password
SESSION_SECRET=generate-at-least-32-random-bytes
PUBLIC_URL=https://payment.byduni.com
